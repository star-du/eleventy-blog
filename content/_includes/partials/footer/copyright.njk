{%- set site = siteConfig.site -%}
{%- set author = siteConfig.author -%}
{%- set author_info -%}
{%- if author.url -%}
  <a href="{{ author.url }}">{{ author.name }}</a>
{%- else -%}
  {{ author.name }}
{%- endif -%}
{%- endset -%}
{%- set startYear -%}
{%- if site.startYear -%}
  {{ site.startYear }}-
{%- endif -%}
{%- endset -%}
<div class="copyright">
  &copy; {{ startYear }}{% currentYear %}
  {{ author_info|safe }}<br>
    <a href="{{ site.generator.url }}">{{ site.generator.name }}</a>
    提供核心引擎<br>
      使用 {{ site.template.credit.name }} 创作的
      <a href="{{ site.template.url }}">{{ site.template.name }}</a>
      模板
    </div>